{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puck-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "puck-web-cache", "preview_id": "puck-web-cache" }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
